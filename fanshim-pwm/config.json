{
  "name": "FanSHIM PWM",
  "version": "1.1",
  "slug": "fanshim-pwm",
  "description": "Control the FanSHIM with PWM on Raspberry Pi 4",
  "arch": ["aarch64"],
  "startup": "before",
  "boot": "auto",
  "options": {
    "temp_min": 45,
    "temp_max": 75,
    "pwm_min": 20,
    "pwm_max": 100,
    "check_interval": 5
  },
  "schema": {
    "temp_min": "int",
    "temp_max": "int",
    "pwm_min": "int",
    "pwm_max": "int",
    "check_interval": "int"
  },
  "privileged": ["SYS_RAWIO"],
  "devices": ["/dev/gpiomem:/dev/gpiomem:rwm"],
  "host_network": true
}
