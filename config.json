{
  "name": "FanSHIM PWM",
  "version": "1.0",
  "slug": "fanshim_pwm",
  "description": "Control the FanSHIM with PWM on Raspberry Pi 4",
  "arch": ["aarch64"],
  "startup": "before",
  "boot": "auto",
  "options": {
    "temp_min": 40,
    "temp_max": 65,
    "pwm_period": 2,
    "check_interval": 10,
    "log_lines": 50
  },
  "schema": {
    "temp_min": "int",
    "temp_max": "int",
    "pwm_period": "int",
    "check_interval": "int",
    "log_lines": "int"
  },
  "map": ["config:rw", "data:rw"],
  "host_network": true,
  "privileged": true,
  "devices": ["/dev/gpiomem", "/dev/gpiochip0"],
  "ports": {}
}
